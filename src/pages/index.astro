          </svg>
          <span class="google-label">Google Reviews</span>
        </div>
        <span class="eyebrow" style="text-align:center; display:block;">What Clients Say</span>
        <h2 style="text-align:center; margin-bottom: 3.5rem;">Verified Reviews</h2>
      </div>

      <div class="reviews-carousel">
        <button class="carousel-btn carousel-btn-prev" aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
